# Copy to .env.local (gitignored). Never commit real values.

# Convex — written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — written by `clerk init`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Also set on each Convex deployment: `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<frontend-api>.clerk.accounts.dev`

# LLM — all model calls route through the Vercel AI Gateway (vision §10). On Vercel, OIDC replaces this.
AI_GATEWAY_API_KEY=

# Photon (iMessage) — portable credentials for the eve channel; `eve add channel/photon-imessage` can write these
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=

# Core <-> Voice seam (convex/VOICE_TOOLS.md §8-§9). ONE trigger path: Core's nightly
# POSTs {EVE_VOICE_URL}/eve/agents/voice/eve/v1/trigger with `x-voice-trigger-secret`.
# (EVE_VOICE_TOKEN and the /eve/v1/session path are retired; VOICE_DEMO_PHONE is gone —
# phone <-> student mapping lives in Convex `students`.)
#
# Two of these are SHARED secrets that must hold the same value in two places:
#  - here (.env.local / the Vercel project env), for the eve host process, AND
#  - on the Convex deployment: `npx convex env set NAME value` (per-deployment;
#    dev and prod do NOT carry over — set again on prod before the first nightly).
CORE_AGENT_SECRET=            # bearer for every /voice/* HTTP route. Both places.
VOICE_TRIGGER_SECRET=         # x-voice-trigger-secret for the trigger route. Both places.
# Convex deployment only:
#   EVE_VOICE_URL             base URL hosting the Voice agent (the Next app / tunnel);
#                             unset => nightly runs record triggerStatus "skipped"
# eve host only:
CORE_URL=                     # Core's .convex.site base; defaults to NEXT_PUBLIC_CONVEX_SITE_URL
VOICE_DEV_PHONE=              # optional, dev/evals: stands in for the Photon principal; resolves through Core

# Optional
FIRECRAWL_API_KEY=            # course-site crawling only (documents use AnyDoc locally)
CANVAS_TOKEN=                 # founder's Duke token for ingestion dev; per-student tokens live in Convex `sources`
CANVAS_BASE_URL=https://canvas.duke.edu
