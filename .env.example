# Copy to .env.local (gitignored). Never commit real values.

# Convex — written by `npx convex dev`
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk — written by `clerk init`
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Also set on each Convex deployment: `npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<frontend-api>.clerk.accounts.dev`

# LLM — all model calls route through the Vercel AI Gateway (vision §10). On Vercel, OIDC replaces this.
AI_GATEWAY_API_KEY=

# Photon (iMessage) — portable credentials for the eve channel; `eve add channel/photon-imessage` can write these
IMESSAGE_PROJECT_ID=
IMESSAGE_PROJECT_SECRET=
IMESSAGE_WEBHOOK_SECRET=

# Voice — Spike A external trigger. A Convex cron POSTs
# /eve/agents/voice/eve/v1/trigger with this in `x-voice-trigger-secret`.
# NOTE: Core's nightly currently targets /eve/v1/session with EVE_VOICE_TOKEN —
# the integration pass reconciles these two into one trigger path.
VOICE_TRIGGER_SECRET=
VOICE_DEMO_PHONE=            # E.164 number registered with the Photon project (spike only)

# Core <-> Voice seam (convex/VOICE_TOOLS.md). All three live on the CONVEX deployment,
# not in .env.local: `npx convex env set NAME value`. Per-deployment - dev and prod
# values do NOT carry over; set them again on prod before the first prod nightly run.
CORE_AGENT_SECRET=            # bearer token every /voice/* HTTP route requires; Voice needs the same value
EVE_VOICE_URL=                # deployed Voice agent base URL; unset => nightly runs record triggerStatus "skipped"
EVE_VOICE_TOKEN=              # bearer for eve's POST /eve/v1/session; required for operationId create-once

# Optional
FIRECRAWL_API_KEY=            # course-site crawling only (documents use AnyDoc locally)
CANVAS_TOKEN=                 # founder's Duke token for ingestion dev; per-student tokens live in Convex `sources`
CANVAS_BASE_URL=https://canvas.duke.edu
